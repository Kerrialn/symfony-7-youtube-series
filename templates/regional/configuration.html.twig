{% extends 'base.html.twig' %}

{% block body %}
    <div class="bg-gray-50 dark:bg-gray-900">
        <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">

            {{ form_start(regionalConfigurationFilter) }}
            {{ form_row(regionalConfigurationFilter.timezone) }}
            {{ form_row(regionalConfigurationFilter.currency) }}
            {{ form_row(regionalConfigurationFilter.locale) }}

            <button type="submit"
                    class="w-full text-white bg-blue-700 hover:bg-blue-900 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                save
            </button>
            {{ form_end(regionalConfigurationFilter) }}

        </div>
    </div>
{% endblock %}